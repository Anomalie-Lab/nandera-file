DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
NEXT_PUBLIC_APP_NAME="Account Status Report Manager"
# false = allow cookies over HTTP (e.g. http://IP:3001). Use true behind HTTPS.
SESSION_SECURE="false"
# Admins: comma-separated email:password. Copy to .env and put real values there.
# Never commit real passwords.
NANDERA_ADMINS="admin@example.com:change-me-now"
