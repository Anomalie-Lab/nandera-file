# Copie para .env na VM (ou mescle com o .env existente).
# Ajuste TRAEFIK_* conforme o container do nandera normal na mesma VM.

# --- Traefik (mesmo stack nandera-prod) ---
TRAEFIK_NETWORK=nandera-prod_edge
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=le
TRAEFIK_HOST=system.nandera.com

# --- Porta no host (só o app; banco e Studio não são expostos) ---
HOST_APP_PORT=38417
ENABLE_PRISMA_STUDIO=0

# --- App ---
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
SESSION_SECURE=true
NANDERA_ADMINS=fernando.arenales@nandera.com:senha-forte

# --- Postgres embutido (volume nandera_pg preserva dados entre deploys) ---
POSTGRES_USER=nandera
POSTGRES_PASSWORD=troque-por-senha-forte
POSTGRES_DB=nandera
POSTGRES_LISTEN_ADDRESSES=127.0.0.1
DATABASE_URL=postgresql://nandera:troque-por-senha-forte@127.0.0.1:5432/nandera
